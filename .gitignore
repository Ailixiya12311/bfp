# Runtime secrets and local-only artifacts.
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
# Exact public upstream certificate fixtures required by Mihomo tests.
!/integrations/mihomo/source/test/config/example.org.pem
!/integrations/mihomo/source/test/config/example.org-key.pem
