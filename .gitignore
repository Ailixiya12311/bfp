*.jsonl
*.zip
*.tar.gz
*.dll
*.test.exe
/integrations/*/results/
/integrations/*/upstream-source/

# Keep verification tooling, tests and descriptions; generated evidence and
# copied source snapshots remain local. Public status is documented in docs.
/verification/**
!/verification/**/
!/verification/**/*.py
!/verification/**/*.ps1
!/verification/**/*.go
!/verification/**/go.mod
!/verification/**/go.sum
!/verification/**/*.md
/verification/**/runs/
/verification/**/source*/
/verification/root-promotion-next25-attempt01/
/verification/**/__pycache__/
